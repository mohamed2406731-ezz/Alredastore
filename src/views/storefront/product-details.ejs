<div class="container product-page" data-product-details data-purchase-product="<%= product.id || '' %>" data-purchase-variant="<%= product.selectedVariant.databaseId || '' %>" data-checkout-enabled="<%= checkoutEnabled %>" data-color-images="<%= JSON.stringify(product.catalogDetails?.presentation?.colorImages || {}) %>" data-selected-label="<%= t('selected') %>" data-variants="<%= product.variantsJson %>" data-selected-variant="<%= product.selectedVariant.id %>">
  <%- include('../partials/breadcrumbs', { items: [{ label: t('home'), href: '/' }, { label: category.name, href: category.href }, { label: product.name }] }) %>
  <div class="product-detail-layout">
    <section class="product-gallery" aria-label="<%= t('productDetails') %>">
      <% if (product.gallery.length) { %><button class="product-main-image" type="button" data-gallery-open aria-label="<%= t('enlargeImage') %>"><img id="product-main-photo" src="<%= product.primaryImage.displaySrc %>" srcset="<%= product.primaryImage.srcSet %>" sizes="(max-width: 760px) calc(100vw - 40px), 420px" data-original-src="<%= product.primaryImage.src %>" alt="<%= product.name %>" width="<%= product.primaryImage.width %>" height="<%= product.primaryImage.height %>" fetchpriority="high"><span><%= t('clickEnlarge') %></span></button>
      <div class="product-thumbnails"><% product.gallery.forEach((image, index) => { %><button type="button" data-gallery-src="<%= image.src %>" data-gallery-display="<%= image.displaySrc %>" data-gallery-srcset="<%= image.srcSet %>" data-gallery-alt="<%= product.name %>" aria-label="<%= t('productImageNumber') %> <%= index + 1 %>" aria-pressed="<%= image.sourceId === product.primaryImage.sourceId %>"><img src="<%= image.thumbSrc || image.cardSrc %>" alt="" width="88" height="88" loading="lazy"></button><% }); %></div><% } else { %><div class="image-placeholder product-main-image"><%= t('noProductImages') %></div><% } %>
    </section>
    <section class="product-information" aria-labelledby="product-title">
      <% if (product.vendor) { %><p class="product-vendor"><%= product.vendor %></p><% } %>
      <h1 id="product-title"><%= product.name %></h1>
      <% if (product.id) { %><button class="favorite-toggle favorite-toggle--detail" type="button" data-favorite-toggle data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" data-save-label="<%= t('saveFavorite') %>" data-remove-label="<%= t('removeFavorite') %>" data-added-message="<%= t('favoriteAdded') %>" data-removed-message="<%= t('favoriteRemoved') %>" aria-pressed="false" aria-label="<%= t('saveFavorite') %>"><%- include('../partials/icon', { name: 'heart' }) %><span><%= t('saveFavorite') %></span></button><% } %>
      <div class="detail-price-row" aria-live="polite"><span class="detail-price" data-variant-price><%= product.selectedVariant.currentFormatted %></span><del data-variant-compare <% if (!product.selectedVariant.compareAtFormatted) { %>hidden<% } %>><%= product.selectedVariant.compareAtFormatted %></del><span class="detail-sale" data-variant-sale <% if (!product.selectedVariant.compareAtFormatted) { %>hidden<% } %>><%= t('sale') %></span></div>
      <p class="price-context" data-variant-availability><%= product.selectedVariant.availabilityLabel %></p>
      <form class="variant-fallback" method="get" action="<%= product.href %>">
        <% if (category.slug) { %><input type="hidden" name="collection" value="<%= category.slug %>"><% } %>
        <label for="variant-fallback"><%= t('productOption') %></label><div><select id="variant-fallback" name="variant"><% product.variants.forEach(variant => { %><option value="<%= variant.id %>" <%= variant.id === product.selectedVariant.id ? 'selected' : '' %>><%= variant.title %> — <%= variant.currentFormatted %></option><% }); %></select><button class="button" type="submit"><%= t('updateSelection') %></button></div>
      </form>
      <div class="product-options" data-product-options hidden><% product.optionGroups.forEach(option => { %>
        <fieldset data-option-index="<%= option.index %>"><legend><%= option.name %></legend><div class="option-values"><% option.values.forEach(choice => { %><label class="product-choice"><input type="radio" name="product-option-<%= option.index %>" value="<%= choice.value %>" <%= product.selectedVariant.options[option.index] === choice.value ? 'checked' : '' %>><span><% if (choice.color) { %><i class="option-color" data-color="<%= choice.color %>" aria-hidden="true"></i><% } %><bdi><%= choice.displayValue %></bdi></span></label><% }); %></div></fieldset>
      <% }); %></div>
      <div class="quantity-row"><label for="product-quantity"><%= t('quantity') %></label><div class="quantity-control"><button type="button" data-quantity-change="-1" aria-label="<%= t('decreaseQuantity') %>">−</button><input id="product-quantity" type="number" min="1" max="99" value="1" inputmode="numeric"><button type="button" data-quantity-change="1" aria-label="<%= t('increaseQuantity') %>">+</button></div></div>
      <div class="product-purchase-actions"><button class="button detail-add add-to-cart" type="button" data-product-id="<%= product.purchaseEligible ? product.id : '' %>" data-product-name="<%= product.name %>" aria-label="<%= t('addToCart') %>: <%= product.name %>" <%= product.purchaseEligible ? '' : 'disabled' %>><%= t('addToCart') %></button><button class="button add-to-cart" type="button" data-buy-now data-product-id="<%= product.purchaseEligible ? product.id : '' %>" data-product-name="<%= product.name %>" <%= product.purchaseEligible && checkoutEnabled ? '' : 'disabled' %>><%= t('buyNow') %></button></div>
      <p class="purchase-context" data-cart-status role="status"><%= product.purchaseEligible ? '' : t(product.purchaseStatus) %></p>
      <p class="selected-option" role="status" data-variant-status><%= t('selected') %>: <%= product.selectedVariant.title %></p>
      <div class="product-description"><h2><%= t('productDetails') %></h2><% if (product.descriptionHtml) { %><div class="product-description-content" lang="<%= product.descriptionLanguage %>" dir="<%= product.descriptionLanguage === 'ar' ? 'rtl' : 'ltr' %>"><%- product.descriptionHtml %></div><% } else { %><p><%= locale === 'ar' ? t('arabicDetailsMissing') : t('englishDetailsMissing') %></p><% } %></div>
      <section class="product-specifications" aria-labelledby="specifications-title"><h2 id="specifications-title"><%= t('moreInformation') %></h2><table><tbody><% product.specifications.forEach(specification => { %><tr><th scope="row"><%= specification.label %></th><td><%= specification.value %></td></tr><% }); %><tr data-variant-sku-row <% if (!product.selectedVariant.sku) { %>hidden<% } %>><th scope="row">SKU</th><td data-variant-sku><%= product.selectedVariant.sku %></td></tr></tbody></table></section>
      <a class="text-link product-back" href="<%= category.href %>"><%= t('backTo') %> <%= category.name %></a>
    </section>
  </div>
  <% if (relatedProducts.length) { %><section class="related-products" aria-labelledby="related-title"><div class="related-heading"><h2 id="related-title"><%= t('youMayLike') %></h2><a class="text-link" href="<%= category.href %>"><%= t('viewCollection') %> →</a></div><%- include('../partials/product-grid', { products: relatedProducts }) %></section><% } %>
  <% if (product.gallery.length) { %><dialog class="product-lightbox" aria-label="<%= t('enlargeImage') %>"><form method="dialog"><button class="icon-button" aria-label="<%= t('closeImage') %>">×</button></form><img alt="<%= product.name %>" width="1000" height="1000"></dialog><% } %>
</div>
<script src="/assets/js/product-gallery.js?v=mobile-gallery-swipe-20261104-1" defer></script>
