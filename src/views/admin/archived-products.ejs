<section class="admin-management admin-catalog">
  <header class="admin-page-heading">
    <div><span class="admin-eyebrow"><%= a('catalog') %></span><h1><%= a('archivedProducts') %></h1><p><%= a('archiveHint') %></p></div>
    <a class="button button-secondary" href="/admin/catalog"><%= a('backToCatalog') %></a>
  </header>
  <% if (savedMessage === 'restored') { %><p class="catalog-save-success" role="status"><%= a('restoreSaved') %></p><% } %>
  <% if (savedMessage === 'deleted') { %><p class="catalog-save-success" role="status"><%= cleanupQueued ? a('productDeleted') : a('productDeleteNoMedia') %></p><% } %>
  <% if (!products.length) { %><section class="workspace-panel"><p><%= a('noArchivedProducts') %></p></section><% } else { %>
    <div class="catalog-product-grid">
      <% for (const product of products) { const cover = product.product_images?.[0]?.secure_url || product.image_url; %>
        <article class="catalog-product-card">
          <div class="catalog-product-image"><img src="<%= cover || '/assets/images/product-placeholder.svg' %>" alt="" loading="lazy"></div>
          <div class="catalog-product-content">
            <h2><%= locale === 'ar' ? product.name_ar : product.name %></h2>
            <p class="catalog-product-price">EGP <%= product.price_egp %></p>
            <form action="/admin/catalog/products/<%= product.id %>/restore" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button" type="submit"><%= a('restoreProduct') %></button></form>
            <details class="catalog-permanent-delete"><summary><%= a('deletePermanently') %></summary><p><%= a('permanentDeleteWarning') %></p>
              <form action="/admin/catalog/products/<%= product.id %>/permanent-delete" method="post" onsubmit="return confirm('<%= a('deletePermanently') %>?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger" type="submit"><%= a('deletePermanently') %></button></form>
            </details>
          </div>
        </article>
      <% } %>
    </div>
  <% } %>
</section>
