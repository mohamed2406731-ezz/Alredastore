<section class="admin-dashboard" aria-labelledby="dashboard-heading">
  <div class="admin-page-heading"><div><span class="admin-eyebrow"><%= a('dashboard') %></span><h1 id="dashboard-heading"><%= dashboardText('title') %></h1><p><%= dashboardText('intro') %></p></div><span class="admin-live"><i aria-hidden="true"></i><%= dashboardText('live') %></span></div>
  <div class="admin-stat-grid">
    <% if (typeof stats.products !== 'undefined') { %><article class="admin-stat"><span><%= dashboardText('products') %></span><strong><%= number(stats.products) %></strong><small><%= dashboardText('categories') %>: <%= number(stats.categories) %></small></article><% } %>
    <% if (typeof stats.orders !== 'undefined') { %><article class="admin-stat"><span><%= dashboardText('orders') %></span><strong><%= number(stats.orders) %></strong><small><%= dashboardText('pending') %>: <%= number(stats.pending) %></small></article><% } %>
    <% if (typeof stats.discounts !== 'undefined') { %><article class="admin-stat"><span><%= dashboardText('discounts') %></span><strong><%= number(stats.discounts) %></strong><small><%= a('discounts') %></small></article><% } %>
    <% if (typeof stats.team !== 'undefined') { %><article class="admin-stat"><span><%= dashboardText('team') %></span><strong><%= number(stats.team) %></strong><small><%= a('roles') %></small></article><% } %>
  </div>
  <section class="admin-quick-section" aria-labelledby="quick-actions-heading"><div class="admin-section-heading"><div><span class="admin-eyebrow"><%= dashboardText('live') %></span><h2 id="quick-actions-heading"><%= dashboardText('quickActions') %></h2></div></div>
    <div class="admin-action-grid">
      <% if (adminPermissions.includes('catalog')) { %><a class="admin-action-card" href="/admin/catalog"><span class="admin-action-icon" aria-hidden="true">▦</span><strong><%= a('catalog') %></strong><p><%= dashboardText('catalogHint') %></p><span class="admin-action-link"><%= dashboardText('open') %><b aria-hidden="true">↗</b></span></a><% } %>
      <% if (adminPermissions.includes('orders')) { %><a class="admin-action-card" href="/admin/orders"><span class="admin-action-icon" aria-hidden="true">▤</span><strong><%= a('orders') %></strong><p><%= dashboardText('ordersHint') %></p><span class="admin-action-link"><%= dashboardText('open') %><b aria-hidden="true">↗</b></span></a><% } %>
      <% if (adminPermissions.includes('catalog')) { %><a class="admin-action-card" href="/admin/promotions"><span class="admin-action-icon" aria-hidden="true">％</span><strong><%= a('discounts') %></strong><p><%= dashboardText('discountsHint') %></p><span class="admin-action-link"><%= dashboardText('open') %><b aria-hidden="true">↗</b></span></a><% } %>
      <% if (adminPermissions.includes('roles')) { %><a class="admin-action-card" href="/admin/access"><span class="admin-action-icon" aria-hidden="true">♙</span><strong><%= a('roles') %></strong><p><%= dashboardText('teamHint') %></p><span class="admin-action-link"><%= dashboardText('open') %><b aria-hidden="true">↗</b></span></a><% } %>
      <% if (adminPermissions.includes('orders')) { %><a class="admin-action-card" href="/admin/notifications"><span class="admin-action-icon" aria-hidden="true">◉</span><strong><%= a('notifications') %></strong><p><%= dashboardText('notificationsHint') %></p><span class="admin-action-link"><%= dashboardText('open') %><b aria-hidden="true">↗</b></span></a><% } %>
    </div>
  </section>
  <% if (adminPermissions.includes('orders')) { %><section class="admin-recent-section" aria-labelledby="recent-orders-heading"><div class="admin-section-heading"><div><span class="admin-eyebrow"><%= a('orders') %></span><h2 id="recent-orders-heading"><%= dashboardText('recentOrders') %></h2></div><a class="admin-view-all" href="/admin/orders"><%= dashboardText('open') %> ↗</a></div>
    <% if (!latestOrders.length) { %><div class="admin-empty-state"><%= dashboardText('emptyOrders') %></div><% } else { %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th><%= a('product') %></th><th><%= a('status') %></th><th><%= t('total') %></th><th></th></tr></thead><tbody><% for (const order of latestOrders) { %><tr><td><a href="/admin/orders/<%= order.id %>"><strong><bdi><%= order.order_number %></bdi></strong></a><small><%= order.customer_name %></small></td><td data-label="<%= a('status') %>"><span class="admin-status"><%= order.status %></span></td><td data-label="<%= t('total') %>">EGP <%= number(order.total_egp) %></td><td><a class="admin-view-all" href="/admin/orders/<%= order.id %>" aria-label="<%= dashboardText('open') %> <%= order.order_number %>">↗</a></td></tr><% } %></tbody></table></div><% } %>
  </section><% } %>
</section>
