<% if (order.payment_method === 'INSTAPAY' && order.payment_proof) { %><section class="instapay-review"><h3><%= locale === 'ar' ? 'مراجعة تحويل InstaPay' : 'InstaPay transfer review' %></h3><a class="button button-secondary" target="_blank" rel="noopener noreferrer" href="/admin/orders/<%= order.id %>/payment-proof"><%= locale === 'ar' ? 'عرض صورة التحويل الخاصة' : 'View private transfer screenshot' %> ↗</a>
      <% if (order.payment_proof.status === 'PENDING' && order.status !== 'CANCELLED') { %><p><%= locale === 'ar' ? 'الصورة ليست إثباتًا كافيًا للدفع. تحقق من وصول المبلغ في حسابك قبل الموافقة.' : 'A screenshot alone is not payment verification. Check the funds in your account before approving.' %></p><form action="/admin/orders/<%= order.id %>/payment-review" method="post"><input type="hidden" name="_csrf" value="<%= typeof csrfToken === 'undefined' ? '' : csrfToken %>"><input type="hidden" name="decision" value="APPROVE"><label><%= locale === 'ar' ? 'مرجع التحويل من حساب الاستقبال' : 'Transfer reference from the receiving account' %><input name="reference" minlength="3" maxlength="120" pattern="[A-Za-z0-9_:/-]{3,120}" required></label><label><input type="checkbox" name="verified" required><%= locale === 'ar' ? 'تحققت من وصول كامل مبلغ الطلب في الحساب' : 'I verified the full order amount arrived in the account' %></label><button class="button" type="submit"><%= locale === 'ar' ? 'اعتماد التحويل وتأكيد الطلب' : 'Approve payment and confirm order' %></button></form>
      <form action="/admin/orders/<%= order.id %>/payment-review" method="post"><input type="hidden" name="_csrf" value="<%= typeof csrfToken === 'undefined' ? '' : csrfToken %>"><input type="hidden" name="decision" value="REJECT"><button class="button button-secondary" type="submit"><%= locale === 'ar' ? 'رفض التحويل وإلغاء الطلب' : 'Reject transfer and cancel order' %></button></form>
      <% } else { %><p><%= locale === 'ar' ? 'نتيجة المراجعة:' : 'Review status:' %> <%= order.payment_proof.status === 'APPROVED' ? (locale === 'ar' ? 'تم الاعتماد' : 'Approved') : (locale === 'ar' ? 'مرفوض أو ملغي' : 'Rejected or cancelled') %></p><% } %></section><% } %>
      
