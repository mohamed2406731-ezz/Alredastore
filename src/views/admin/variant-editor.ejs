<% const editorSeed = typeof buildVariantEditor === 'function' ? buildVariantEditor(editing) : { enabled:false, options:[{name:'Color',nameAr:'اللون'},{name:'Type',nameAr:'النوع'}],rows:[] }; %>
<fieldset class="variant-editor" data-variant-editor data-locale="<%= locale %>">
  <legend><%= locale === 'ar' ? 'الأنواع والألوان والأسعار' : 'Types, colors & prices' %></legend>
  <label class="admin-check"><input type="checkbox" data-variant-editor-toggle <%= editorSeed.enabled ? 'checked' : '' %>><span><%= locale === 'ar' ? 'إدارة كل اختيار بسعر وصورة مستقلين' : 'Manage each combination with its own price and photo' %></span></label>
  <input type="hidden" name="variantEditor" data-variant-editor-value value="<%= JSON.stringify(editorSeed) %>">
  <div data-variant-editor-controls hidden>
    <p class="catalog-color-help"><%= locale === 'ar' ? 'الاختيارات الحالية محمّلة كما هي. كل كارت يمثل نوعًا ولونًا ومقاسًا محددًا.' : 'Existing choices are loaded as saved. Each card is one exact type, color and size.' %></p>
    <details class="variant-generator"><summary><%= locale === 'ar' ? 'إضافة أنواع وألوان أو مقاسات جديدة' : 'Add types, colors or sizes' %></summary><div data-variant-options></div><div class="variant-generator-actions"><button type="button" class="button button-secondary" data-add-variant-option><%= locale === 'ar' ? 'إضافة بُعد للاختيار' : 'Add option dimension' %></button><button type="button" class="button" data-generate-variants><%= locale === 'ar' ? 'إنشاء الاختيارات الناقصة' : 'Generate missing combinations' %></button></div></details>
    <div class="variant-editor-toolbar"><label><%= locale === 'ar' ? 'بحث في الاختيارات' : 'Search combinations' %><input type="search" data-variant-search></label><label><%= locale === 'ar' ? 'عرض نوع أو لون' : 'Filter type or color' %><select data-variant-filter><option value=""><%= locale === 'ar' ? 'الكل' : 'All' %></option></select></label><button type="button" class="button button-secondary" data-add-variant-row><%= locale === 'ar' ? 'إضافة اختيار واحد' : 'Add one combination' %></button></div>
    <details class="variant-bulk"><summary><%= locale === 'ar' ? 'تطبيق عرض أو صورة على الاختيارات الظاهرة' : 'Apply an offer or image to visible combinations' %></summary><p data-variant-bulk-count></p><div class="variant-bulk-controls"><label><%= locale === 'ar' ? 'سعر العرض (فارغ لإلغائه)' : 'Offer price (empty to remove)' %><input type="number" min="1" max="10000000" step="1" data-variant-bulk-offer></label><button type="button" class="button button-secondary" data-apply-variant-offer><%= locale === 'ar' ? 'تطبيق العرض' : 'Apply offer' %></button><label><%= locale === 'ar' ? 'الصورة' : 'Image' %><select data-variant-bulk-image></select></label><button type="button" class="button button-secondary" data-apply-variant-image><%= locale === 'ar' ? 'تطبيق الصورة' : 'Apply image' %></button></div></details>
    <p class="variant-editor-status" role="status" aria-live="polite" data-variant-editor-status></p>
    <div class="variant-editor-grid" data-variant-rows></div>
  </div>
</fieldset>
