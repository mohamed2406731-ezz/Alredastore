<section class="admin-management admin-catalog" data-admin-catalog data-uploading="<%= a('uploadingImages') %>" data-uploaded="<%= a('uploadedImages') %>" data-upload-failed="<%= a('uploadFailed') %>" data-remove-image="<%= a('removeImage') %>">
  <header class="admin-page-heading">
    <div><span class="admin-eyebrow"><%= a('workspace') %></span><h1><%= a('catalog') %></h1><p><%= a('required') %></p></div>
    <% if (editing) { %><a class="button button-secondary" href="/admin/catalog"><%= a('backToCatalog') %></a><% } else if (selectedCategory) { %><a class="button button-secondary" href="/admin/catalog"><%= a('backToCollections') %></a><% } else { %><a class="button button-secondary" href="/admin/catalog/homepage"><%= a('homepageCollections') %></a><a class="button button-secondary" href="/admin/catalog/archived"><%= a('archivedProducts') %></a><% } %>
  </header>
  <% if (typeof savedMessage !== 'undefined' && savedMessage) { %><p class="catalog-save-success" role="status" aria-live="polite"><%= a(savedMessage) %></p><% } %>

  <% if (!selectedCategory) { %>
  <form class="workspace-panel admin-form catalog-editor" action="/admin/catalog/products" method="post">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken === 'undefined' ? '' : csrfToken %>">
    <div class="catalog-editor-heading"><div><span class="admin-eyebrow"><%= a('product') %></span><h2><%= a(editing ? 'edit' : 'newProduct') %></h2></div><button class="button" type="submit"><%= a('save') %></button></div>
    <input type="hidden" name="id" value="<%= editing?.id || '' %>">
    <input type="hidden" name="expectedUpdatedAt" value="<%= editing?.updated_at ? new Date(editing.updated_at).toISOString() : '' %>">
    <%- include('bilingual-field', { prefix:'product', key:'name', value:editing?.name, arValue:editing?.name_ar, multiline:false, required:true }) %>
    <%- include('bilingual-field', { prefix:'product', key:'description', value:editing?.description, arValue:editing?.description_ar, multiline:true, required:false }) %>
    <%- include('bilingual-field', { prefix:'product', key:'color', value:editing?.catalog_details?.color_en, arValue:editing?.catalog_details?.color_ar, multiline:false, required:false }) %>
    <% const existingColorNames = new Set(String(editing?.catalog_details?.color_en || '').split(/[,;|/]+/).map(value => value.trim()).filter(Boolean)); const savedColorImages = []; const managedColorVariants = Boolean(editing?.product_variants?.some(item => item.color_hex)); if (editing?.product_variants) { for (const variant of editing.product_variants) { let options = []; try { options = JSON.parse(variant.options || '[]'); } catch {} const colorName = options.find(value => (colorOptions || []).some(color => color.en === value)); const managedColor = !managedColorVariants || Boolean(variant.color_hex); if (colorName && !managedColorVariants) existingColorNames.add(colorName); const image = editing.product_images?.find(item => item.source_id === variant.source_image_id); if (colorName && managedColor && existingColorNames.has(colorName)) { const saved = savedColorImages.find(item => item.color === colorName); if (saved) { saved.stock += variant.stock_quantity || 0; if (!saved.imageUrl && image) saved.imageUrl = image.secure_url; } else savedColorImages.push({ color: colorName, imageUrl: image?.secure_url || '', stock: variant.stock_quantity || 0 }); } } } const legacyColorPrice = color => { if (editing?.catalog_details?.presentation?.colorPrices || editing?.catalog_details?.presentation?.manageTypes) return null; const prices = new Set((editing?.product_variants || []).filter(variant => { try { return JSON.parse(variant.options || '[]').includes(color); } catch { return false; } }).map(variant => Number(variant.price_egp))); const price = [...prices][0]; return prices.size === 1 && Number.isInteger(price) && price > 0 && price !== Number(editing?.price_egp) ? price : null; }; const initialColors = (colorOptions || []).filter(color => existingColorNames.has(color.en)).map((color, index) => ({ color: color.en, imageUrl: savedColorImages.find(item => item.color === color.en)?.imageUrl || (editing?.product_images?.[0]?.secure_url || editing?.image_url || ''), salePriceEgp: editing?.catalog_details?.presentation?.colorOffers?.[color.en] ?? null, priceEgp: editing?.catalog_details?.presentation?.colorPrices?.[color.en] ?? legacyColorPrice(color.en), stock: savedColorImages.find(item => item.color === color.en)?.stock ?? (index === 0 ? (editing?.stock_quantity || 0) : 0) })); %>
    <% const existingColorOffers = {}; for (const variant of editing?.product_variants || []) { if (Number(variant.compare_at_egp) <= Number(variant.price_egp)) continue; let values = []; try { values = JSON.parse(variant.options || '[]'); } catch {} for (const color of colorOptions || []) { if (values.includes(color.en)) existingColorOffers[color.en] = Math.min(existingColorOffers[color.en] ?? Infinity, Number(variant.price_egp)); } } %>
    <fieldset class="catalog-color-picker" data-catalog-color-picker data-color-image-label="<%= a('colorImage') %>" data-color-stock-label="<%= a('stock') %>" data-color-offer-label="<%= a('offerPrice') %>" data-current-offer-label="<%= a('currentOffer') %>" data-existing-color-offers="<%= JSON.stringify(existingColorOffers) %>" data-color-product-offer="<%= editing?.sale_price_egp ?? '' %>" data-color-price-label="<%= a('colorPrice') %>" data-no-image-label="<%= a('uploadColorImageFirst') %>"><legend><%= a('chooseColor') %></legend><div class="catalog-color-options"><% for (const color of (colorOptions || [])) { %><button type="button" class="catalog-color-choice" data-color-choice data-color-en="<%= color.en %>" data-color-ar="<%= color.ar %>" aria-pressed="<%= existingColorNames.has(color.en) ? 'true' : 'false' %>" title="<%= locale === 'ar' ? color.ar : color.en %>"><span class="catalog-color-dot" style="--swatch-color:<%= color.hex %>" aria-hidden="true"></span><span><%= locale === 'ar' ? color.ar : color.en %></span></button><% } %></div><input type="hidden" name="colorVariants" value="<%= JSON.stringify(initialColors) %>" data-color-variants><div class="catalog-color-image-list" data-color-image-list></div></fieldset>
    <%- include('bilingual-field', { prefix:'product', key:'type', value:editing?.catalog_details?.type_en, arValue:editing?.catalog_details?.type_ar, multiline:false, required:false }) %>
    <div class="admin-fields">
      <label><%= a('category') %><select name="categoryId" required><% for (const category of categories) { %><option value="<%= category.id %>" <%= editing?.category_id === category.id ? 'selected' : '' %>><%= locale === 'ar' ? category.name_ar : category.name %></option><% } %></select></label>
      <label><%= a('price') %><input name="priceEgp" type="number" min="1" max="10000000" step="1" value="<%= editing?.price_egp || '' %>" required></label>
      <label><%= a('offerPrice') %><input name="salePriceEgp" type="number" min="1" max="10000000" step="1" value="<%= editing?.sale_price_egp ?? '' %>" aria-describedby="offer-price-hint"></label>
      <input type="hidden" name="stock" value="0">
    </div>
    <p id="offer-price-hint" class="catalog-color-help"><%= a('offerPriceHint') %></p>
    <fieldset class="catalog-media" data-image-upload data-kind="product">
      <legend><%= a('images') %></legend>
      <label class="catalog-upload-drop"><span class="catalog-upload-icon" aria-hidden="true">+</span><strong><%= a('uploadImages') %></strong><small><%= a('uploadHint') %></small><input type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple data-image-files></label>
      <input type="hidden" name="images" data-image-urls value="<%= editing ? (editing.product_images.length ? editing.product_images.map(image => image.secure_url) : [editing.image_url]).filter(Boolean).join('\n') : '' %>">
      <div class="catalog-upload-status" data-upload-status role="status" aria-live="polite"></div>
      <div class="catalog-image-previews" data-image-previews>
        <% const productImages = editing ? (editing.product_images.length ? editing.product_images.map(image => image.secure_url) : [editing.image_url]).filter(Boolean) : []; for (const image of productImages) { %><figure><img src="<%= image %>" alt="" loading="lazy"><button type="button" data-remove-image aria-label="<%= a('removeImage') %>">×</button></figure><% } %>
      </div>
      <details><summary><%= a('advancedImageLinks') %></summary><textarea dir="ltr" data-image-urls-fallback aria-label="<%= a('advancedImageLinks') %>"><%= productImages.join('\n') %></textarea></details>
    </fieldset>
    <%- include('product-presentation') %>
    <%- include('variant-editor') %>
    <p class="catalog-color-help"><%= a('colorVariantHint') %></p><p class="catalog-color-help"><%= a('colorPriceHint') %></p>
    <label class="admin-check"><input type="checkbox" name="available" <%= !editing || editing.is_available ? 'checked' : '' %>><%= a('available') %></label>
    <button class="button" type="submit"><%= a('save') %></button>
  </form>

  <details class="workspace-panel catalog-create-category"><summary><%= a('newCategory') %></summary>
    <form class="admin-form" action="/admin/catalog/categories" method="post" data-image-upload data-kind="category">
      <%- include('bilingual-field', { prefix:'category', key:'name', value:'', arValue:'', multiline:false, required:true }) %>
      <%- include('bilingual-field', { prefix:'category', key:'description', value:'', arValue:'', multiline:true, required:false }) %>
      <label><%= a('slug') %><input name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="80" dir="ltr" required data-category-slug></label>
      <fieldset class="catalog-media"><legend><%= a('image') %></legend><label class="catalog-upload-drop"><span class="catalog-upload-icon" aria-hidden="true">+</span><strong><%= a('uploadImages') %></strong><small><%= a('uploadHint') %></small><input type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-image-files></label>
        <input type="hidden" name="imageUrl" data-category-image-url value=""><div class="catalog-upload-status" data-upload-status role="status" aria-live="polite"></div><div class="catalog-image-previews" data-image-previews></div>
        <details><summary><%= a('advancedImageLinks') %></summary><input type="url" maxlength="2048" dir="ltr" data-category-url-fallback></details>
      </fieldset>
      <label><%= a('homepageSection') %><select name="homeSectionId"><option value=""><%= a('hideFromHomepage') %></option><% for(const section of sections) { %><option value="<%= section.id %>"><%= locale === 'ar' ? section.title_ar : section.title_en %></option><% } %></select></label>
      <button class="button" type="submit"><%= a('add') %></button>
    </form>
  </details>
  <% } %>

  <% if (!editing && !selectedCategory) { %>
  <section class="catalog-managed-section"><header><div><span class="admin-eyebrow"><%= a('catalog') %></span><h2><%= a('categories') %></h2></div><span class="catalog-count"><%= categories.length %></span></header>
    <div class="catalog-category-grid">
      <% for (const category of categories) { %><a class="catalog-category-card" href="/admin/catalog?category=<%= category.id %>"><img src="<%= category.image_url || category.previewImage || '/assets/images/product-placeholder.svg' %>" alt="" loading="lazy"><span><strong><%= locale === 'ar' ? category.name_ar : category.name %></strong><small><%= category.slug %></small><span class="catalog-card-arrow" aria-hidden="true">→</span></span></a><% } %>
    </div>
  </section>
  <% } %>

  <% if (!editing) { %><section class="catalog-managed-section"><header><div><span class="admin-eyebrow"><%= a('product') %></span><h2><%= selectedCategory ? (categories.find(item => item.id === selectedCategory) ? (locale === 'ar' ? categories.find(item => item.id === selectedCategory).name_ar : categories.find(item => item.id === selectedCategory).name) : a('products')) : a('products') %></h2></div><span class="catalog-count"><%= products.length %></span></header>
    <% if (selectedCategory) { %><p><a class="text-link" href="/admin/catalog"><%= a('allProducts') %> ×</a></p><% } %>
    <div class="catalog-product-grid">
      <% for (const product of products) { const cover = product.product_images?.[0]?.secure_url || product.image_url; const category = categories.find(item => item.id === product.category_id); %>
        <% const productSwatches = resolveColorSwatches(product.catalog_details?.color_en || product.catalog_details?.color_ar || ''); %>
        <article class="catalog-product-card"><a class="catalog-product-image" href="/admin/catalog/products/<%= product.id %>/edit"><img src="<%= cover || '/assets/images/product-placeholder.svg' %>" alt="" loading="lazy"></a><div class="catalog-product-content"><p class="catalog-product-category"><%= category ? (locale === 'ar' ? category.name_ar : category.name) : a('category') %></p><% if (productSwatches.length) { %><div class="catalog-card-colors" aria-label="<%= a('color') %>"><% for (const color of productSwatches) { %><span class="catalog-color-dot" style="--swatch-color:<%= color.hex %>" role="img" aria-label="<%= locale === 'ar' ? color.ar : color.en %>" title="<%= locale === 'ar' ? color.ar : color.en %>"></span><% } %></div><% } %><h3><%= locale === 'ar' ? product.name_ar : product.name %></h3><p class="catalog-stock-left"><span><%= a('remainingStock') %></span><strong><%= Number(product.stock_quantity ?? 0).toLocaleString(locale === 'ar' ? 'ar-EG' : 'en-EG') %></strong></p><p class="catalog-product-price"><% if (product.sale_price_egp != null) { %><del>EGP <%= product.price_egp %></del> <strong>EGP <%= product.sale_price_egp %></strong><% } else { %>EGP <%= product.price_egp %><% } %></p><a class="text-link" href="/admin/catalog/products/<%= product.id %>/edit"><%= a('edit') %> →</a><form action="/admin/catalog/products/<%= product.id %>/archive" method="post" onsubmit="return confirm('<%= a('archiveProduct') %>?')"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><button class="button button-secondary" type="submit"><%= a('archiveProduct') %></button></form></div></article>
      <% } %>
    </div>
  </section><% } %>
</section>
