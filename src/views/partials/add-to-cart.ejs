<% const purchasable = product.purchaseEligible === true && typeof product.id === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(product.id); %>
<button class="button add-to-cart" type="button" data-product-id="<%= purchasable ? product.id : '' %>" data-variant-id="<%= product.variantId || '' %>" data-product-name="<%= product.name %>" aria-label="<%= t(product.unavailable ? 'unavailable' : 'addToCart') %>: <%= product.name %>" <%= purchasable ? '' : 'disabled' %>><%= t(product.unavailable ? 'unavailable' : 'addToCart') %></button>
<span class="shopping-note" data-cart-status role="status"><%= purchasable || product.unavailable ? '' : t(product.purchaseStatus || 'variantPurchasingPending') %></span>
