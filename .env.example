NODE_ENV=development
HOST=127.0.0.1
PORT=666
# Digits only, including country code. Blank disables the contact button.
WHATSAPP_PHONE=
WHATSAPP_GREETING="Hello Alreda Store, I would like to ask about your products."
# Optional: send confirmed order details to the store using WhatsApp Business Cloud API.
# Create an approved template with six body parameters; keep the access token server-side.
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORDER_RECIPIENT=
WHATSAPP_ORDER_TEMPLATE=order_confirmation
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v23.0

# Leave all credentials blank until an authorized Cloudinary account is available.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=alreda-store
# auto reads the account folder mode once; fixed/dynamic can be configured explicitly.
CLOUDINARY_FOLDER_MODE=auto
# Read-only public manifest delivery, useful for display-only Preview without API credentials.
MEDIA_PUBLIC_MANIFEST=false
MEDIA_MAX_UPLOAD_BYTES=20971520
MEDIA_MAX_IMAGE_COUNT=12

# Runtime Neon URL: use the Neon -pooler hostname. Keep credentials in runtime secrets.
DATABASE_URL=
# Neon supplies this unpooled URL for Prisma CLI migrations. It must match DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Alternative name supported for providers that call their migration URL DIRECT_URL.
DIRECT_URL=
DATABASE_POOL_MAX=5
# Per process/instance, not per request. Start at 2-5 on free/serverless tiers.
DATABASE_CONNECT_TIMEOUT_MS=15000
# Defaults to true in production and false locally when omitted.
# DATABASE_REQUIRED=true

# Google OAuth: authorized redirect must exactly match this local callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:666/auth/google/callback
# Optional server-side Arabic translation for the admin catalog integration.
# Generate a random value of at least 32 characters; never commit it.
SESSION_SECRET=

# OneSignal web push. REST API key is server-only and must never be exposed to browsers.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ABANDONED_CART_AFTER_MINUTES=120
# Optional scheduler credential (32-256 non-whitespace characters).
# GET /api/jobs/run requires Authorization: Bearer <CRON_SECRET>.
# Vercel functions do not run the local timers; configure a suitable scheduler separately.
CRON_SECRET=

# Keep disabled until authentication, reviewed database changes and real stock are configured.
CHECKOUT_ENABLED=false
CHECKOUT_ORIGIN=
# JSON object of approved city names to whole-EGP shipping fees; do not invent live rates.
CHECKOUT_SHIPPING_RATES={}

# Optional Photon-compatible HTTPS reverse endpoint. Free default; no API key.
# Used only after the customer clicks Use my location. Keep moderate usage.
REVERSE_GEOCODING_URL=https://photon.komoot.io/reverse

# Enable only after adding the real receiving phone and either a QR or direct URL.
INSTAPAY_ENABLED=false
INSTAPAY_PHONE=
INSTAPAY_URL=
# Public Cloudinary QR URL or an approved /assets/... image path.
INSTAPAY_QR_URL=
